<section class="product">

    {% if item %}
    {% block details %}
    <div class="container">
        <div class="row mt-5 ">
            <div class="col-md-5">
                <blockquote class="blockquote">
                    <h3>{{ item.title }}</h3>

                    <div class="mt-3">
                        <div class="blockquote-footer ">{{ item.subtitle }}</div>
                    </div>
                </blockquote>

                {{ welcome_message }}
            </div>


        </div>

        <div class="row mt-5 ">
            <div class="col-8">
                <p>{{ item.description }}</p>
            </div>
            <div class="col-4">
                <div class="ribbon-container">
                    <div class="label">{{ item.folgentyp }}</div>


                <div class="text-left">
                    Vom: {{ item.pubdate|date('d.m.Y') }}<br>
                    <small>{{ zeit_vergangen }}</small>
                </div>


                <div class="text-left link-minkorrekt">
                    <a href="{{ item.link }}"><i class="bi bi-box-arrow-up-right"></i> Minkorrekt</a>
                </div>

                <div class="text-left">
                    <strong>Dauer</strong>
                    {{ (item.duration // 3600) ~ 'h ' ~ ((item.duration % 3600) // 60) ~ 'm' }}
                    <br>
                    {{ item.duration }} Sekunden
                </div>

                <div class="text-left">
                    {{ item.enclosure }}
                </div>
                </div>
            </div>
        </div>

        <div class="container">
        {% for passage in item.passages %}
            <div class="row">
                <div class="col-10">
            {{ passage.content|raw }}
                </div>
                <div class="col-2">
                    {{ passage.themaart|raw }}
                </div>
            </div>
        {% endfor %}

        {% endblock %}
        {% endif %}
</section>